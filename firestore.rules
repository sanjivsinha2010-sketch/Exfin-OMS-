rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // GLOBAL SAFETY NET & PRIMITIVES
    // =================================================================
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for auth and roles
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email.endsWith('@exfin.com'));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserData(userId) {
      return userExists(userId) ? get(/databases/$(database)/documents/users/$(userId)).data : {};
    }

    function getRole(userId) {
      return userExists(userId) && ('role' in get(/databases/$(database)/documents/users/$(userId)).data)
        ? get(/databases/$(database)/documents/users/$(userId)).data.role
        : '';
    }

    function getEmployeeId(userId) {
      return userExists(userId) && ('employeeId' in get(/databases/$(database)/documents/users/$(userId)).data)
        ? get(/databases/$(database)/documents/users/$(userId)).data.employeeId
        : '';
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'g7NoFi86xuRJsYxDIuoctSDarjr2' ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'sanjivsinha2010@gmail.com') ||
        getRole(request.auth.uid) == 'Master Admin' || 
        getRole(request.auth.uid) == 'MASTER_ADMIN'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isMasterAdmin() ||
        getRole(request.auth.uid) == 'Admin'
      );
    }

    function isHR() {
      return isSignedIn() && (
        isMasterAdmin() ||
        getRole(request.auth.uid) == 'HR'
      );
    }

    function isTeamLeader() {
      return isSignedIn() && (
        isMasterAdmin() ||
        getRole(request.auth.uid) == 'Team Leader'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =================================================================
    // VALIDATION BLUEPRINTS
    // =================================================================

    function isValidEmployee(data) {
      return data.employeeId is string && data.employeeId.size() <= 64 &&
             data.employeeName is string && data.employeeName.size() <= 128 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 20 &&
             data.deviceId is string && data.deviceId.size() <= 128 &&
             data.status is string && (data.status == 'Pending' || data.status == 'Approved' || data.status == 'Rejected');
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role is string && (data.role == 'Master Admin' || data.role == 'MASTER_ADMIN' || data.role == 'Admin' || data.role == 'HR' || data.role == 'Team Leader' || data.role == 'Employee');
    }

    function isValidAttendance(data) {
      return data.attendanceId is string && data.attendanceId.size() <= 128 &&
             data.employeeId is string && data.employeeId.size() <= 64 &&
             data.attendanceType is string && (data.attendanceType == 'OFFICE' || data.attendanceType == 'WFH' || data.attendanceType == 'Client Visit' || data.attendanceType == 'Client Site');
    }

    function isValidExpense(data) {
      return data.expenseId is string && data.expenseId.size() <= 128 &&
             data.employeeId is string && data.employeeId.size() <= 64 &&
             data.amount is number && data.amount >= 0 &&
             data.status is string && (data.status == 'Pending' || data.status == 'Approved' || data.status == 'Paid' || data.status == 'Rejected');
    }

    function isValidLeaveRequest(data) {
      return data.leaveId is string && data.leaveId.size() <= 128 &&
             data.employeeId is string && data.employeeId.size() <= 64 &&
             data.status is string && (data.status == 'Pending' || data.status == 'Approved' || data.status == 'Rejected' || data.status == 'Cancelled');
    }

    // =================================================================
    // ROUTING & ACCESS CONTROL MATRIX
    // =================================================================

    // USERS (Auth base)
    match /users/{document=**} {
      allow read: if isSignedIn() && (request.auth.uid == document || isAdmin() || isHR() || isMasterAdmin());
      allow create: if (isSignedIn() && request.auth.uid == document && isValidUser(incoming()) && incoming().role == 'Employee') || isMasterAdmin();
      allow update: if isSignedIn() && (
        (request.auth.uid == document && incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'name', 'email', 'uid'])) ||
        isAdmin() ||
        isMasterAdmin()
      );
      allow delete: if isMasterAdmin();
    }

    // EMPLOYEES
    match /employees/{document=**} {
      allow read: if true; // Public access for device identification checks
      allow create: if true; // Public registration submission
      allow update: if isHR() || isAdmin() || isMasterAdmin() || 
                      (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['syncedToGoogleSheets', 'appVersion']));
      allow delete: if isAdmin() || isMasterAdmin();
    }

    // ROLE ASSIGNMENTS & LIST LOOKUPS
    match /admins/{id} {
      allow read, write: if isMasterAdmin();
    }

    match /hr/{id} {
      allow read: if isAdmin() || isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    match /teamLeaders/{id} {
      allow read: if isAdmin() || isHR() || isMasterAdmin();
      allow write: if isAdmin() || isMasterAdmin();
    }

    // ATTENDANCE LOGS
    match /attendance/{attendanceId} {
      allow create: if true; // PWA allows offline submissions & client-side guest checkins
      allow read: if isSignedIn() && (
        isHR() || isAdmin() || isMasterAdmin() ||
        (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
        (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid))
      );
      allow update: if isHR() || isAdmin() || isMasterAdmin() ||
                      (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
                      (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid) && incoming().status == 'Checked Out');
      allow delete: if isAdmin() || isMasterAdmin();
    }

    // EXPENSES CLAIMS
    match /expenses/{expenseId} {
      allow create: if true; // Allow claim submission
      allow read: if isSignedIn() && (
        isHR() || isAdmin() || isMasterAdmin() ||
        (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
        (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid))
      );
      allow update: if isHR() || isAdmin() || isMasterAdmin() ||
                      (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
                      (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid) && existing().status == 'Pending' && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'amount', 'description', 'attachmentUrl', 'remarks']));
      allow delete: if isAdmin() || isMasterAdmin() ||
                      (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid) && existing().status == 'Pending');
    }

    // LEAVE REQUESTS
    match /leaveRequests/{leaveId} {
      allow create: if true; // Allow application submission
      allow read: if isSignedIn() && (
        isHR() || isAdmin() || isMasterAdmin() ||
        (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
        (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid))
      );
      allow update: if isHR() || isAdmin() || isMasterAdmin() ||
                      (isTeamLeader() && existing().teamLeaderId == request.auth.uid) ||
                      (getEmployeeId(request.auth.uid) != '' && existing().employeeId == getEmployeeId(request.auth.uid) && incoming().status == 'Cancelled');
      allow delete: if isAdmin() || isMasterAdmin();
    }

    // SYSTEM NOTIFICATIONS
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if isHR() || isAdmin() || isMasterAdmin();
    }

    // GEOFENCE PARAMETERS & ACTIVE SHAPES
    match /geofence/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isMasterAdmin();
    }

    // COMPANY SETTINGS & GLOBAL CONFIGURATION
    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /companySettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /holidays/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isMasterAdmin() || isHR();
    }

    match /leaveBalances/{document=**} {
      allow read: if true;
      allow write: if isHR() || isAdmin() || isMasterAdmin();
    }

    // SECURITY AUDIT LOGS
    match /auditLogs/{document=**} {
      allow create: if true;
      allow read: if isHR() || isAdmin() || isMasterAdmin();
      allow write: if isMasterAdmin() || isAdmin();
    }
  }
}
